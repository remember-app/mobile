{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "files": {
    "includes": ["src/**", "*.json", "*.mjs", "*.ts", "!package-lock.json"]
  },
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "json": { "parser": { "allowComments": true } },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "single" }
  },
  "linter": {
    "rules": {
      "a11y": {
        // `role` on the kit's `Text` is its own typography role — `display`, `meta`, `subtitle`
        // (`design/spec.md` 3) — and not an ARIA one. This is a web rule reading a phone's props.
        "useValidAriaRole": "off"
      },
      "correctness": {
        // Every effect this catches leaves something out on purpose: the words (`s`) so a language
        // switch does not re-run a mount-time effect, and refs, which never change identity.
        "useExhaustiveDependencies": "off"
      },
      "suspicious": {
        // The lists it catches stand in fixed positions — scale ticks, the three photos of the
        // first screen, the weeks of a month — where the place in the row *is* the identity.
        "noArrayIndexKey": "off"
      }
    }
  }
}

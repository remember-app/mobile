require "base64"

default_platform(:ios)

platform :ios do
  # Загружает метаданные в ASC, не загружая и не сабмитя бинарник.
  lane :metadata do
    key_path = File.join(ENV.fetch("RUNNER_TEMP", "/tmp"), "AuthKey.p8")
    File.write(key_path, Base64.decode64(ENV.fetch("ASC_PRIVATE_KEY_B64")))

    key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: key_path,
      in_house: false
    )

    deliver(
      api_key: key,
      app_identifier: "com.noxlabs.remember",
      skip_binary_upload: true,
      submit_for_review: false,
      force: true
    )
  end
end

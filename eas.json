{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.remember-app.fun"
      }
    },
    "testflight": {
      "distribution": "store",
      "autoIncrement": true,
      "channel": "dev",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.remember-app.fun"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "ascAppId": "6816034455"
      }
    }
  }
}
